# Copy to .env and adjust. Never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Production refuses missing, short or published keys. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Optional: its own key for the session tokens (changing it signs everybody out).
# JWT_SIGNING_KEY=
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Madrid
LOG_LEVEL=INFO

# --- Database (docker compose provides its own) ---
DATABASE_URL=postgres://entrenanutricion:entrenanutricion@localhost:5432/entrenanutricion
# Only for docker-compose.prod.yml (local production stack): its database password, required.
# POSTGRES_PASSWORD=a-random-value

# --- Media storage: local filesystem unless USE_GCS=1 ---
USE_GCS=0
GS_BUCKET_NAME=
# Service-account key as a single-line JSON string (needs a private key to sign URLs).
GS_CREDENTIALS_JSON=
GS_EXPIRATION_MINUTES=15

# --- Rate limits (DRF throttling) ---
THROTTLE_LOGIN=10/min
# Failed sign-ins per account and IP, with 5 times that in total per account (a success or a new
# password clears them).
THROTTLE_LOGIN_ACCOUNT=10/hour
THROTTLE_REGISTER=10/min
THROTTLE_PASSWORD=5/min
THROTTLE_EMAIL_EXISTS=10/min
# Session renewal and sign-out, per IP.
THROTTLE_SESSION=120/min
# Downloads of a user's data, per user.
THROTTLE_DATA_EXPORT=5/hour
# Notes to the team or to a client (reading is not limited).
THROTTLE_NOTES=30/min
# Requests with files (photos, images and videos), per user.
THROTTLE_UPLOADS=100/hour

# --- Session cookie (refresh token, httpOnly) ---
# Secure is on except in config.settings.dev (plain HTTP). SameSite=Lax needs the app and the API on
# the same site (same origin, the Render rewrite or app./api. subdomains); use None otherwise.
# AUTH_COOKIE_SECURE=1
# AUTH_COOKIE_SAMESITE=Lax
# Proxies in front of Django appending to X-Forwarded-For (rate limits per client): 0 locally.
NUM_PROXIES=0

# --- Database backups (manage.py backup_database / restore_drill) ---
# GS_BACKUP_BUCKET_NAME=
# Its own service account (one-line JSON), allowed only to create objects in that bucket.
# GS_BACKUP_CREDENTIALS_JSON=
# 0: the bucket's lifecycle rule deletes the old dumps (the job then needs no right to delete).
# BACKUP_PRUNE=1
# BACKUP_DIR=backend/backups
BACKUP_RETENTION_DAYS=14
# PG_BIN_DIR=   # folder with pg_dump / pg_restore if they are not on the PATH

# --- Data protection (GDPR) ---
PRIVACY_POLICY_VERSION=2026-11
ACCOUNT_RETENTION_DAYS=365
# Shown in the privacy policy (frontend build): fill them in before going live.
VITE_PRIVACY_CONTROLLER=
VITE_PRIVACY_CONTACT=
# VITE_PRIVACY_POLICY_VERSION, VITE_ACCOUNT_RETENTION_DAYS and VITE_BACKUP_RETENTION_DAYS must match
# the API values above when they are changed.

# --- Email (password recovery). Console backend prints the emails in the backend log ---
# Production refuses it (the links would end up in the logs) unless ALLOW_CONSOLE_EMAIL=1.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# ALLOW_CONSOLE_EMAIL=0
# For real emails: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=entrenanutricion <no-reply@entrenanutricion.dev>
# Public URL of the frontend (links in the emails).
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT_MINUTES=60
THROTTLE_PASSWORD_RESET=5/min

# --- Error monitoring (Sentry). Empty DSN = off. Nothing personal is sent ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend (build time)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# --- Business ---
# Training time of the clients who have not chosen one (countdown and reminders).
DEFAULT_TRAINING_TIME=18:00
# Reminders are emailed within this many minutes before the training time (hourly job: >= 60).
REMINDER_LEAD_MINUTES=60

# --- docker compose: load demo data on backend start (1/0) ---
SEED_DEMO=1
# Password of the demo accounts. Development uses the one in the README; seed_demo
# --allow-production (DEBUG off) requires one of your own.
# DEMO_PASSWORD=

# --- Production only (config.settings.prod) ---
# Set to 0 only behind plain HTTP (docker-compose.prod.yml); keep the defaults on Render.
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# Serve /media from Django when there is no GCS (local production stack only).
# SERVE_MEDIA=0
# Django admin and public API docs (/api/docs/, /api/schema/): off in production unless 1.
# ADMIN_ENABLED=0
# API_DOCS_PUBLIC=0
# gunicorn workers (Render sets PORT; WEB_CONCURRENCY is read by the Dockerfile and render.yaml).
# WEB_CONCURRENCY=3

# --- Frontend (Vite) ---
# Base URL of the API as seen by the browser. Default "/api/v1" uses the Vite dev proxy.
VITE_API_URL=/api/v1
# Where the Vite dev server proxies /api and /media.
VITE_PROXY_TARGET=http://127.0.0.1:8000
